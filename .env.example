# Copy this file to .env and replace the placeholder values.
# Never commit .env - it holds your real database password.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# If the password contains special characters (@ : / # ? &), URL-encode them.
DATABASE_URL="postgresql://inventory_app:CHANGE_ME@localhost:5432/inventory_management?schema=public"
